<Window
    x:Class="PomoPet.App.Windows.FloatingPillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PomoPet Mini">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Border Padding="12,6" CornerRadius="20">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image x:Name="PillPetImage" Width="28" Height="28" Stretch="Uniform" />
            <TextBlock x:Name="PillTimerText" Text="25:00"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="PillToggleButton" Content="▶" Click="Toggle_Click"
                    Width="28" Height="28" Padding="0" CornerRadius="14" />
        </StackPanel>
    </Border>
</Window>

<Window
    x:Class="PomoPet.App.Windows.BreakOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Time to Rest">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#CC121E28" KeyDown="Root_KeyDown">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
            <TextBlock x:Name="OverlayTagText" Text="TIME TO REST"
                       Foreground="#8FE6D1" FontWeight="Bold" FontSize="14"
                       CharacterSpacing="160" HorizontalAlignment="Center" />

            <Image x:Name="OverlayPetImage" Width="128" Height="128" Stretch="Uniform" />

            <TextBlock x:Name="OverlayTimerText" Text="05:00"
                       Foreground="White" FontSize="64" FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <Border Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                    CornerRadius="20" Padding="28,18" MaxWidth="460">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PromptTitleText" Text="20-20-20 Eye Rest"
                               Foreground="White" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="PromptSubtitleText"
                               Text="Look at something 20 feet away for 20 seconds."
                               Foreground="#CCFFFFFF" FontSize="14" TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                <Button Content="Snooze 5 min" Click="Snooze_Click" CornerRadius="20" Padding="22,10" />
                <Button Content="Skip Break" Click="Skip_Click" CornerRadius="20" Padding="22,10" />
            </StackPanel>

            <TextBlock Text="Press Esc to close overlay" Foreground="#66FFFFFF"
                       FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
